# Production env template for Laravel Forge. Copy to `.env` on the server and fill
# the blanks. Do NOT commit the real .env. See docs/deployment/forge.md.

APP_NAME="ATMA Journey"
APP_ENV=production
APP_KEY=                       # php artisan key:generate (once, on the server)
APP_DEBUG=false
APP_URL=https://atmajourney.com.br   # the CENTRAL (signup/marketing) domain

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Central database. stancl creates one DB per tenant at runtime, so the DB user
# below MUST have CREATE/DROP DATABASE privileges (see docs/deployment/forge.md).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atma_central
DB_USERNAME=forge
DB_PASSWORD=

# Multitenancy — the central domain(s). Tenant subdomains are {slug}.{first entry}.
# Apex serves signup/marketing; *.atmajourney.com.br are clinic tenants.
TENANCY_CENTRAL_DOMAINS=atmajourney.com.br,www.atmajourney.com.br

# Sessions: database driver pinned to the never-swapped `central` connection, with
# host-only cookies (per-subdomain isolation). See config/database.php.
SESSION_DRIVER=database
SESSION_CONNECTION=central
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local          # consider s3 for tenant files at scale
QUEUE_CONNECTION=database      # run a Forge queue worker (see docs)
CACHE_STORE=database

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="nao-responda@atmajourney.com.br"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
